{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the interface may ask the Rust side to do.",
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*:*/*"
        },
        {
          "url": "https://*:*/*"
        }
      ]
    },
    "opener:default"
  ],
  "webviews": [
    "main"
  ]
}